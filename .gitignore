# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/

# Secrets
.env
.env.local

# Personas — each persona is a self-contained folder. The fictional
# `_example` persona ships with the repo as the format reference; any
# real personas live locally and are not committed.
personas/*
!personas/_example/
# Within _example, cleaned.json + synthetic_queries.json are generated
# by the pipeline. Users running the quickstart regenerate them.
personas/_example/cleaned.json
personas/_example/synthetic_queries.json

# Runtime state — quota counters and per-channel conversation history.
# Created on the fly by the bot, never committed.
state/

# Project planning notes — kept locally, not committed.
PROJECT_BRIEF.md

# ChromaDB local persistence
chroma/

# Logs
*.log
logs/

# macOS / editors
.DS_Store
.vscode/
.idea/