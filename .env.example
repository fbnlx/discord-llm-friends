# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# This file holds ONLY secrets (API keys, Discord tokens) and a few
# environment-specific bits (the test guild id, env-var overrides for
# selected runtime knobs). All non-secret tunables live in config.yaml.


# --- LLM provider API keys --------------------------------------------------
# Only the key for the provider you select in config.yaml is strictly
# required at runtime; the others can stay empty.

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Note: OPENAI_API_KEY is also used for embeddings regardless of which
# LLM provider is selected — the embedding model is OpenAI's by design.


# --- Discord bot tokens (one per persona) ----------------------------------
# Convention: DISCORD_TOKEN_<UPPER_PERSONA_ID>. Must match
# `discord.token_env` in the persona's persona.yaml.
# Create each bot at https://discord.com/developers/applications.

DISCORD_TOKEN_EXAMPLE=
# Add one DISCORD_TOKEN_<UPPER_ID> per persona you define.


# --- Discord guild scoping (optional, recommended for development) --------
# Set to your test server's id to make slash commands appear INSTANTLY
# in that one server. Leave empty for global sync, which can take up to
# an hour to propagate but works in any server the bot is in.
# To find your guild id: enable Developer Mode in Discord settings, then
# right-click the server icon → Copy Server ID.

DISCORD_GUILD_ID=


# --- Optional env overrides for config.yaml values ------------------------
# These three env vars, if set, override the corresponding values in
# config.yaml at process start. Useful for differentiating
# dev/staging/prod without committing a different config.yaml.

#LLM_PROVIDER=gemini       # overrides config.yaml `llm.provider`
#DAILY_LIMIT=50            # overrides config.yaml `bot.daily_limit_per_user`
#HISTORY_TURNS=3           # overrides config.yaml `bot.history_turns_in_prompt`
